# Stress test: absolute-address var init interleaved with indexed array access
# Mimics blocks.min pattern: pos() with @ vars + testShape() with array indexing.
# On the buggy build, this may trigger "Buffer overflow" intermittently.
# On the fixed build, this must always complete without error.

def setpos(char x, char y):
  char posx @ 0x00c0 = x
  char posy @ 0x00c1 = y

char field = field[|200]

def fillfield():
  int i = 0
  while i < 200:
    field[i] = char(i)
    i += 1

def checkfield(int x, int y):
  int tx = x + 1; int ty = y + 2
  if tx < 0 or tx > 9: return 0
  if ty < 0 or ty > 19: return 0
  int idx = tx + 10 * ty
  if field[idx] != char(idx): return -1
  return 0

print("Starting test ...\n")
fillfield()

int i = 0
int errors = 0

# Tight loop: setpos then indexed array check, 5000 iterations
while i < 5000:
  int x = i - i / 10 * 10
  int y = i / 10 - i / 200 * 20
  setpos(char(x), char(y))
  int result = checkfield(x, y)
  if result != 0:
    errors += 1
  i += 1

setpos(0, 0)
print("iters: ")
print(i)
print(" errors: ")
print(errors)
print("\n")
if errors == 0:
  print("PASS\n")
else:
  print("FAIL\n")
