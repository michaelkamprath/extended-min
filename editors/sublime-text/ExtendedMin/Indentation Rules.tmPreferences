<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>scope</key>
  <string>source.xmin</string>
  <key>settings</key>
  <dict>
    <!-- Blocks open after if/elif/else/while/def lines, with or without a trailing ':' -->
    <key>increaseIndentPattern</key>
    <string>^\s*(if|elif|else|while|def)\b.*$</string>
  </dict>
</dict>
</plist>
